PORT=3001
RABBITMQ_URL=amqp://rabbitmq:5672
DB_HOST=orders-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=orders_db
# order-service verifies the JWT itself rather than trusting a gateway header,
# because port 3001 is published. Must be byte-identical to auth-service (the
# issuer) and api-gateway.
JWT_SECRET=dev-only-change-me-in-production
