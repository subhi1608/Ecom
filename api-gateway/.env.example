PORT=3000
ORDER_SERVICE_URL=http://order-service:3001
INVENTORY_SERVICE_URL=http://inventory-service:3002
AUTH_SERVICE_URL=http://auth-service:3005
CORS_ORIGIN=http://localhost:5173

# Verification only — the gateway never signs tokens. Must be byte-identical
# to auth-service (the issuer) and order-service, or JwtAuthGuard rejects
# every request as an invalid session.
JWT_SECRET=dev-only-change-me-in-production
