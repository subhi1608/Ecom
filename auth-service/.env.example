PORT=3005
DB_HOST=auth-db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=auth_db

# auth-service is the ONLY issuer of JWTs; api-gateway and order-service both
# verify against this same secret. All three .env files must carry a byte-
# identical JWT_SECRET or every authenticated request 401s with a signature
# error that looks like a broken login rather than a config mismatch.
JWT_SECRET=dev-only-change-me-in-production

# Drives token lifetime. The gateway reads the token's own `exp` claim to set
# the auth cookie's maxAge, so changing this here propagates automatically.
JWT_EXPIRES_IN=1h
