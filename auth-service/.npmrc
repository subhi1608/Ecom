# @nestjs/terminus@10 declares a peer dep on @nestjs/typeorm ^9||^10, but this
# repo pins @nestjs/typeorm@12 across every service. npm's default ERESOLVE
# behaviour fails the install outright — including the `npm install` inside
# the Dockerfile, which would break the image build.
#
# Setting this here (rather than passing --legacy-peer-deps on the command
# line) means local installs and Docker builds behave identically.
legacy-peer-deps=true
